# Local mode needs no .env. These placeholders are for a future authorized cloud setup.
UNCRUD_ENV=dev
UNCRUD_PROJECT_ID=replace-with-dev-project-id
UNCRUD_DATABASE_ID=(default)
UNCRUD_ALLOWED_ORIGINS=https://replace-with-hosting-origin.invalid
VITE_FIREBASE_PROJECT_ID=replace-with-dev-project-id
VITE_FIREBASE_API_KEY=replace-with-public-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain.invalid
VITE_FIREBASE_APP_ID=replace-with-public-firebase-app-id
VITE_FIRESTORE_DATABASE_ID=(default)
